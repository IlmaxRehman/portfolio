# Gmail example: use an "app password", not your normal password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
TO_EMAIL=youraddress@gmail.com

# Comma-separated list of frontend URLs allowed to call this API in production
ALLOWED_ORIGINS=https://your-deployed-frontend.vercel.app
